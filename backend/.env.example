# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas)
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hopehaven?retryWrites=true&w=majority

# JWT Secrets
JWT_SECRET=your_super_secret_jwt_access_key_here
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_here
JWT_REFRESH_EXPIRES_IN=7d

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Payment Gateway (Phase 3)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
